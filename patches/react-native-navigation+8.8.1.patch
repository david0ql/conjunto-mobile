 @implementation RNNOverlayWindow
 
+// With UIScene lifecycle (mandatory on the iOS 27 SDK) a window created with
+// initWithFrame: has no windowScene and is never shown, so attach overlays to
+// the app's window scene.
+- (instancetype)initWithFrame:(CGRect)frame {
+    UIWindowScene *windowScene = UIApplication.sharedApplication.delegate.window.windowScene;
+    if (windowScene == nil) {
+        for (UIScene *scene in UIApplication.sharedApplication.connectedScenes) {
+            if ([scene isKindOfClass:[UIWindowScene class]]) {
+                windowScene = (UIWindowScene *)scene;
+                break;
+            }
+        }
+    }
+    if (windowScene != nil) {
+        self = [super initWithWindowScene:windowScene];
+        self.frame = frame;
+        return self;
+    }
+    return [super initWithFrame:frame];
+}
